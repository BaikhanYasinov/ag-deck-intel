ANTHROPIC_API_KEY=sk-ant-...

# модели
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_MAIN=claude-sonnet-5

# мандат фонда AG Ventures
FUND_NAME=AG Ventures
CHECK_MIN_USD=10000
CHECK_TARGET_USD=25000
CHECK_MAX_USD=50000
THESIS_STAGE=pre-seed / seed
THESIS_SECTOR=IT
THESIS_GEO=Кыргызстан

# ограничения
MAX_PAGES=100
MAX_FILE_MB=50
CONCURRENCY=4
RENDER_DPI=150
MAX_VISION_PAGES=30

# обогащение внешними данными выключено: поискового API нет
ENRICHMENT_ENABLED=false

# --------------------------------------------------------------------------- #
# Провайдер моделей
# --------------------------------------------------------------------------- #
# anthropic | ollama | vllm | lmstudio | transformers
LLM_PROVIDER=anthropic

# локальный OpenAI-совместимый эндпойнт
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
LOCAL_MODEL=qwen3-vl:8b
# Отдельная модель для простых ролей. Раскомментируйте, только если она
# реально скачана: ollama pull <тег>. По умолчанию берётся LOCAL_MODEL.
# LOCAL_MODEL_FAST=qwen3-vl:4b
LOCAL_CONCURRENCY=1

# transformers в процессе приложения
TRANSFORMERS_MODEL=Qwen/Qwen3-VL-8B-Instruct
TRANSFORMERS_DEVICE=auto

# batch | per_page | auto
VISION_MODE=auto
MAX_IMAGES_PER_CALL=8

# Точечная маршрутизация: любая роль на любом провайдере.
# Роли: classifier, structurizer, onepager, team, problem_solution, market,
#       product, business_model, traction, ask_deal_fit
# MODEL_ROLE_CLASSIFIER=ollama:qwen3-vl:4b
# MODEL_ROLE_STRUCTURIZER=ollama:qwen3-vl:8b
# MODEL_ROLE_TEAM=anthropic:claude-sonnet-5

# Полностью офлайн, без моделей и ключей: конвейер на синтетических данных.
# LLM_PROVIDER=mock
